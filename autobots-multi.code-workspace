{
  "folders": [
    {
      "name": "workspace-root",
      "path": "."
    },
    {
      "name": "autobots-devtools-shared-lib",
      "path": "autobots-devtools-shared-lib"
    },
    {
      "name": "autobots-agents-jarvis",
      "path": "autobots-agents-jarvis"
    },
    {
      "name": "autobots-agents-mer",
      "path": "autobots-agents-mer"
    },
    {
      "name": "autobots-agents-pay",
      "path": "autobots-agents-pay"
    },
    {
      "name": "canvas",
      "path": "canvas"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder:workspace-root}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "autobots-devtools-shared-lib": true,
      "autobots-agents-jarvis": true,
      "autobots-agents-mer": true,
      "autobots-agents-pay": true,
      "canvas": true,
    },
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "[python]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
      }
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff"
    ]
  }
}
